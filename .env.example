# Wave Accounting Full Access Token.
# Generate at https://developer-apps.waveapps.com/apps/create/ -> "Create token".
# Keep secret. .env is gitignored.
WAVE_API_TOKEN=

# Optional: override Wave GraphQL endpoint (defaults to public endpoint).
# WAVE_GRAPHQL_URL=https://gql.waveapps.com/graphql/public

# Auth mode: env_token (default for stdio) | bearer_passthrough (default for http).
# WAVE_AUTH_MODE=env_token

# Logging
# LOG_LEVEL=info
