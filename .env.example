# Wave Accounting Full Access Token.
# Generate at https://developer-apps.waveapps.com/apps/create/ -> "Create token".
# Keep secret. .env is gitignored.
WAVE_AUTH_MODE=env_token
WAVE_API_TOKEN=
WAVE_DEFAULT_BUSINESS_ID=

# Wave public GraphQL endpoint.
WAVE_GRAPHQL_ENDPOINT=https://gql.waveapps.com/graphql/public

# HTTP hardening and local defaults.
# Add https://claude.ai when exposing /mcp to Claude over HTTP.
ALLOWED_ORIGINS=http://localhost:*
RATE_LIMIT_RPM=60

# Logging
LOG_LEVEL=info
LOG_PII=false
NODE_ENV=development
