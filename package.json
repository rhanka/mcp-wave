{
  "name": "mcp-wave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "coverage": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.yml",
    "dev:stdio": "tsx watch src/entrypoints/stdio.ts",
    "dev:http": "tsx watch src/entrypoints/http.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "codegen:introspect": "node --env-file-if-exists=.env node_modules/@graphql-codegen/cli/cjs/bin.js --config codegen.introspect.yml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.0",
    "hono": "^4.6.0",
    "p-retry": "8.0.0",
    "pino": "10.3.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@graphql-codegen/add": "7.0.0",
    "@graphql-codegen/cli": "7.0.0",
    "@graphql-codegen/schema-ast": "6.0.0",
    "@graphql-codegen/typescript": "6.0.1",
    "@graphql-codegen/typescript-graphql-request": "7.0.1",
    "@graphql-codegen/typescript-operations": "6.0.2",
    "@hono/node-server": "2.0.2",
    "@types/node": "25.8.0",
    "@vitest/coverage-v8": "4.1.6",
    "execa": "^9.5.0",
    "fast-check": "4.8.0",
    "msw": "2.14.6",
    "tsx": "4.22.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
